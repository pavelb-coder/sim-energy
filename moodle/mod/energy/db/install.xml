<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/energy/db" VERSION="20261113" COMMENT="MOD_ENERGY schema">
  <TABLES>
    <TABLE NAME="energy" COMMENT="Экземпляры активности «Виртуальная лаборатория»">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="benchess" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="circuits,renew,storage,efficiency" SEQUENCE="false" COMMENT="Доступные стенды: circuits,renew,storage,efficiency"/>
        <FIELD NAME="gradetarget" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="3" SEQUENCE="false" COMMENT="Заданий для полного балла"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="energy_progress" COMMENT="Прогресс студента по стендам">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="energyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="solved" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: {&quot;renew&quot;:{&quot;0&quot;:3}}"/>
        <FIELD NAME="stars" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: сумма звёзд по стендам"/>
        <FIELD NAME="best" TYPE="number" LENGTH="5" DECIMALS="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Доля выполненных заданий 0…1"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="energyid" TYPE="foreign" FIELDS="energyid" REFTABLE="energy" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="energyid-userid" UNIQUE="true" FIELDS="energyid,userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
